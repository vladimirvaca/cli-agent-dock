<!-- Plugin Configuration File. Read more: https://plugins.jetbrains.com/docs/intellij/plugin-configuration-file.html -->
<idea-plugin>
    <id>com.github.vladimirvaca.cliagentdock</id>
    <name>CLI Agent Dock</name>
    <vendor>vladimirvaca</vendor>

    <description><![CDATA[
        <p><b>CLI Agent Dock</b> brings your favorite coding agent right into your JetBrains IDE —
        no more alt-tabbing to a terminal window. It adds a dedicated tool window to the right
        side bar (next to Database, Gradle, and friends) with an embedded terminal that
        automatically launches a coding agent CLI in your project.</p>
        <p>By default it opens with <b>Claude Code</b>; <b>GitHub Copilot CLI</b>,
        <b>OpenAI Codex CLI</b> and <b>OpenCode</b> are supported too. Pick an agent from the
        dropdown and open as many sessions as you like — each runs in its own closeable tab, so
        you can drive several agents at once. Your preferred agent is remembered across projects
        and restarts.</p>
        <ul>
        <li>Embedded terminal, pre-launched with your agent CLI in your project directory</li>
        <li>Multiple independent, closeable agent sessions per project</li>
        <li>Send the file and lines you're looking at into the agent's prompt, ready for your
        instruction — no copy-pasting paths</li>
        <li>A notification when an agent goes quiet in a tab you're not watching, so an
        approval prompt doesn't sit unnoticed</li>
        <li>Every action in Find Action and rebindable in Settings &gt; Keymap</li>
        <li>Live "files changed" panel — see what the agent touched as it works, with
        one-click diffs for each file and a jump to the commit view</li>
        <li>Esc reaches the agent (e.g. to interrupt it) instead of leaving the terminal;
        double-tap Esc to jump back to the editor, Shift+Esc to hide the dock</li>
        <li>Cross-platform: Windows, macOS, and Linux</li>
        </ul>
    ]]></description>

    <depends>com.intellij.modules.platform</depends>
    <depends>org.jetbrains.plugins.terminal</depends>

    <resource-bundle>messages.CliAgentDockBundle</resource-bundle>

    <extensions defaultExtensionNs="com.intellij">
        <toolWindow
            id="CLI Agent Dock"
            anchor="right"
            icon="/icons/cliAgentDock.svg"
            factoryClass="com.github.vladimirvaca.cliagentdock.toolWindow.CliAgentDockToolWindowFactory"/>

        <!-- AgentSettingsState is a light service (@Service) and must not also be registered here. -->

        <applicationConfigurable
            parentId="tools"
            id="com.github.vladimirvaca.cliagentdock.settings.AgentSettingsConfigurable"
            instance="com.github.vladimirvaca.cliagentdock.settings.AgentSettingsConfigurable"
            displayName="CLI Agent Dock"/>

        <notificationGroup
            id="CLI Agent Dock"
            displayType="BALLOON"
            bundle="messages.CliAgentDockBundle"
            key="notification.group.name"/>
    </extensions>

    <!--
      Actions are registered here rather than built inline by the tool window panel, so
      they appear in Find Action / Search Everywhere and can be rebound in Settings >
      Keymap. The two toolbars are assembled from the groups below, keeping one definition
      per action. Action text/description come from the classes (which read the message
      bundle), so they are not duplicated as XML attributes.
    -->
    <actions>
        <action id="CliAgentDock.NewSession"
                class="com.github.vladimirvaca.cliagentdock.actions.NewSessionAction"/>
        <action id="CliAgentDock.RestartSession"
                class="com.github.vladimirvaca.cliagentdock.actions.RestartSessionAction"/>
        <action id="CliAgentDock.OpenSettings"
                class="com.github.vladimirvaca.cliagentdock.actions.OpenDockSettingsAction"/>

        <!--
          Default shortcuts verified free against the bundled $default and
          "Mac OS X 10.5+" keymaps of the target platform (only ctrl+alt+shift H is taken
          there), so they should not stomp on an existing binding.
        -->
        <action id="CliAgentDock.FocusDock"
                class="com.github.vladimirvaca.cliagentdock.actions.FocusDockAction">
            <keyboard-shortcut keymap="$default" first-keystroke="ctrl alt shift D"/>
            <keyboard-shortcut keymap="Mac OS X 10.5+" first-keystroke="meta alt shift D"/>
        </action>

        <action id="CliAgentDock.SendContext"
                class="com.github.vladimirvaca.cliagentdock.actions.SendContextAction">
            <keyboard-shortcut keymap="$default" first-keystroke="ctrl alt shift A"/>
            <keyboard-shortcut keymap="Mac OS X 10.5+" first-keystroke="meta alt shift A"/>
            <add-to-group group-id="EditorPopupMenu" anchor="last"/>
            <add-to-group group-id="ProjectViewPopupMenu" anchor="last"/>
        </action>

        <group id="CliAgentDock.Toolbar">
            <reference ref="CliAgentDock.NewSession"/>
            <reference ref="CliAgentDock.RestartSession"/>
        </group>

        <group id="CliAgentDock.SettingsToolbar">
            <reference ref="CliAgentDock.OpenSettings"/>
        </group>
    </actions>
</idea-plugin>
